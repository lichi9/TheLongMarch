# 统一换行，避免 Windows 成员提交的 CRLF 在 diff 里刷满整个文件
* text=auto eol=lf

*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.txt     text eol=lf

# 二进制：明确标记，git 才不会尝试做文本合并
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.mp3     binary
*.ogg     binary
*.wav     binary
